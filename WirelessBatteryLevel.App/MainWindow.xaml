<Window x:Class="WirelessBatteryLevel.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:WirelessBatteryLevel.App.Controls"
        mc:Ignorable="d"
        Title="Wireless Battery Level" 
        Height="380" Width="340"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        RenderOptions.BitmapScalingMode="HighQuality"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">

    <Window.Resources>
        <!-- Custom ScrollBar Style -->
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="5"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid x:Name="Bg" SnapsToDevicePixels="true">
                            <Track x:Name="PART_Track" IsDirectionReversed="true" IsEnabled="{TemplateBinding IsMouseOver}">
                                <Track.Thumb>
                                    <Thumb Style="{DynamicResource ScrollBarThumb}"/>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ScrollBarThumb" TargetType="Thumb">
            <Setter Property="OverridesDefaultStyle" Value="true"/>
            <Setter Property="IsTabStop" Value="false"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Rectangle x:Name="rectangle" RadiusX="0" RadiusY="0" Fill="#52525B" Height="{TemplateBinding Height}" Width="{TemplateBinding Width}"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="true">
                                <Setter TargetName="rectangle" Property="Fill" Value="#71717A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Main Container Card (Flush to screen edges, Margin 0) -->
    <Border Margin="0" CornerRadius="0" Background="#1F1F1F" BorderBrush="#3A3A3C" BorderThickness="1" SnapsToDevicePixels="True">
        <Grid Margin="12" SnapsToDevicePixels="True">
            <Grid.RowDefinitions>
                <!-- Header -->
                <RowDefinition Height="Auto"/>
                <!-- Divider -->
                <RowDefinition Height="Auto"/>
                <!-- Device List -->
                <RowDefinition Height="*"/>
                <!-- Footer -->
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header Panel -->
            <Grid Grid.Row="0" Margin="2,0,2,6" Background="Transparent" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Bluetooth App Logo (Win10 White Icon, Hover System Accent) -->
                <Path Grid.Column="0"
                      Data="M 10 2 L 10 24 L 17 17 L 12 12.5 L 17 8 L 10 2 M 10 12.5 L 4 6.5 M 10 12.5 L 4 18.5"
                      Fill="Transparent" 
                      StrokeThickness="1.5" 
                      Width="13" Height="17" 
                      Stretch="Uniform" 
                      Margin="0,0,8,0"
                      VerticalAlignment="Center"
                      ToolTip="Bluetooth"
                      Style="{StaticResource BluetoothLogoHoverStyle}"
                      SnapsToDevicePixels="True"/>

                <!-- Title & Author -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Wireless Battery" 
                               Style="{StaticResource AccentTextHoverStyle}"
                               FontWeight="SemiBold" 
                               FontSize="13.5" 
                               VerticalAlignment="Center"/>

                    <!-- Author Subtitle (Hover System Accent) -->
                    <TextBlock Text="Made by Ztk" 
                               Style="{StaticResource SubtitleHoverStyle}"
                               FontSize="9.5" 
                               VerticalAlignment="Bottom" 
                               Margin="6,0,0,2"
                               ToolTip="Author"/>
                </StackPanel>

                <!-- Action Buttons (Refresh, Settings & Close - CornerRadius="0" No rounded corners) -->
                <StackPanel Grid.Column="2" HorizontalAlignment="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Refresh Button (Hover System Accent, CornerRadius=0) -->
                    <Button Command="{Binding RefreshCommand}"
                            Background="Transparent"
                            BorderThickness="0"
                            Cursor="Hand"
                            Margin="0"
                            ToolTip="Refresh">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="btnBorder" Background="Transparent" CornerRadius="0" Padding="8,6">
                                    <Path x:Name="btnPath" Data="M 12 4 C 7.58 4 4 7.58 4 12 C 4 16.42 7.58 20 12 20 C 15.45 20 18.42 17.82 19.55 14 L 17.45 14 C 16.48 16.35 14.43 18 12 18 C 8.69 18 6 15.31 6 12 C 6 8.69 8.69 6 12 6 C 13.66 6 15.14 6.69 16.22 7.78 L 13 11 L 20 11 L 20 4 L 17.63 6.37 C 16.19 4.9 14.2 4 12 4 Z"
                                          Fill="#9CA3AF" Width="13" Height="13" Stretch="Uniform" SnapsToDevicePixels="True"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="btnBorder" Property="Background" Value="#2D2D30"/>
                                        <Setter TargetName="btnPath" Property="Fill" Value="{DynamicResource SystemAccentBrush}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- Settings Button (Hover System Accent, CornerRadius=0) -->
                    <Button Click="SettingsButton_Click"
                            Background="Transparent"
                            BorderThickness="0"
                            Cursor="Hand"
                            Margin="0"
                            ToolTip="Settings">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="settingsBorder" Background="Transparent" CornerRadius="0" Padding="8,6">
                                    <Path x:Name="settingsPath" Data="M 12 15 C 10.34 15 9 13.66 9 12 C 9 10.34 10.34 9 12 9 C 13.66 9 15 10.34 15 12 C 15 13.66 13.66 15 12 15 Z M 19.43 12.97 C 19.47 12.65 19.5 12.33 19.5 12 C 19.5 11.67 19.47 11.34 19.43 11.03 L 21.54 9.37 C 21.73 9.22 21.78 8.95 21.66 8.73 L 19.66 5.27 C 19.54 5.05 19.27 4.96 19.05 5.05 L 16.56 6.05 C 16.04 5.66 15.48 5.32 14.87 5.07 L 14.49 2.42 C 14.46 2.18 14.25 2 14 2 L 10 2 C 9.75 2 9.54 2.18 9.51 2.42 L 9.13 5.07 C 8.52 5.32 7.96 5.66 7.44 6.05 L 4.95 5.05 C 4.73 4.96 4.46 5.05 4.34 5.27 L 2.34 8.73 C 2.21 8.95 2.27 9.22 2.46 9.37 L 4.57 11.03 C 4.53 11.34 4.5 11.67 4.5 12 C 4.5 12.33 4.53 12.65 4.57 12.97 L 2.46 14.63 C 2.27 14.78 2.21 15.05 2.34 15.27 L 4.34 18.73 C 4.46 18.95 4.73 19.03 4.95 18.95 L 7.44 17.95 C 7.96 18.34 8.52 18.68 9.13 18.93 L 9.51 21.58 C 9.54 21.82 9.75 22 10 22 L 14 22 C 14.25 22 14.46 21.82 14.49 21.58 L 14.87 18.93 C 15.48 18.68 16.04 18.34 16.56 17.95 L 19.05 18.95 C 19.27 19.03 19.54 18.95 19.66 18.73 L 21.66 15.27 C 21.78 15.05 21.73 14.78 21.54 14.63 L 19.43 12.97 Z"
                                          Fill="#9CA3AF" Width="13" Height="13" Stretch="Uniform" SnapsToDevicePixels="True"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="settingsBorder" Property="Background" Value="#2D2D30"/>
                                        <Setter TargetName="settingsPath" Property="Fill" Value="{DynamicResource SystemAccentBrush}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Divider -->
            <Rectangle Grid.Row="1" Height="1" Fill="#3A3A3C" Margin="0,2,0,8" SnapsToDevicePixels="True"/>

            <!-- Device List Container -->
            <Grid Grid.Row="2">
                <!-- Empty State Message -->
                <TextBlock Text="No Bluetooth devices found"
                           Foreground="#8E8E93"
                           FontSize="12"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           FontStyle="Italic">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Devices.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <!-- Devices ItemsControl (Card Height scaled 1.5x, component sizes enlarged) -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding Devices}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,6" 
                                        BorderThickness="0"
                                        CornerRadius="2" 
                                        Cursor="Hand"
                                        SnapsToDevicePixels="True">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#2B2B2B"/>
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#38383B"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <!-- Left Accent Indicator Bar (Green if connected, Gray otherwise) -->
                                            <ColumnDefinition Width="5"/>
                                            <!-- Card Main Content -->
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- 5px Indicator Bar -->
                                        <Rectangle Grid.Column="0" 
                                                   Fill="{Binding IndicatorBrush}" 
                                                   SnapsToDevicePixels="True"/>

                                        <!-- Content Grid with 1.5x scaled padding (Margin 12,11) -->
                                        <Grid Grid.Column="1" Margin="12,11">
                                            <Grid.ColumnDefinitions>
                                                <!-- Device Name -->
                                                <ColumnDefinition Width="*"/>
                                                <!-- Battery Percentage & Icon -->
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Scaled Device Name (13.5pt, Hover System Accent) -->
                                            <TextBlock Grid.Column="0" 
                                                       Text="{Binding Name}" 
                                                       Style="{StaticResource AccentTextHoverStyle}"
                                                       FontSize="13.5" 
                                                       FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis" 
                                                       ToolTip="{Binding FullTooltipText}"
                                                       VerticalAlignment="Center"/>

                                            <!-- Scaled Battery Info Stack (Percentage Text 13pt + Win10 Battery Icon) -->
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                <!-- Percentage Text (Hover System Accent) -->
                                                <TextBlock Text="{Binding BatteryPercentageText}"
                                                           Style="{StaticResource AccentTextHoverStyle}"
                                                           FontSize="13"
                                                           FontWeight="Bold"
                                                           VerticalAlignment="Center"
                                                           Margin="0,0,8,0"
                                                           ToolTip="{Binding BatteryTooltip}"/>

                                                <!-- Scaled Battery Icon -->
                                                <controls:BatteryIcon VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>

            <!-- Footer Panel -->
            <Grid Grid.Row="3" Margin="0,8,0,0">
                <!-- Left: Last Updated Subtitle (Hover System Accent) -->
                <TextBlock Text="{Binding LastUpdatedText}" 
                           Style="{StaticResource SubtitleHoverStyle}"
                           FontSize="9.5" 
                           HorizontalAlignment="Left" 
                           VerticalAlignment="Center"/>

                <!-- Right: Version Subtitle (Hover System Accent) -->
                <TextBlock Text="v1.0.0" 
                           Style="{StaticResource SubtitleHoverStyle}"
                           FontSize="9.5" 
                           HorizontalAlignment="Right" 
                           VerticalAlignment="Center"
                           ToolTip="Version 1.0.0"/>
            </Grid>
        </Grid>
    </Border>
</Window>
