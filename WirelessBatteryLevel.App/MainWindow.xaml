<Window x:Class="WirelessBatteryLevel.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:WirelessBatteryLevel.App.Controls"
        mc:Ignorable="d"
        Title="Wireless Battery Level" 
        Height="360" Width="320"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        RenderOptions.BitmapScalingMode="HighQuality"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">

    <Window.Resources>
        <!-- Custom ScrollBar Style -->
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="6"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid x:Name="Bg" SnapsToDevicePixels="true">
                            <Track x:Name="PART_Track" IsDirectionReversed="true" IsEnabled="{TemplateBinding IsMouseOver}">
                                <Track.Thumb>
                                    <Thumb Style="{DynamicResource ScrollBarThumb}"/>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ScrollBarThumb" TargetType="Thumb">
            <Setter Property="OverridesDefaultStyle" Value="true"/>
            <Setter Property="IsTabStop" Value="false"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Rectangle x:Name="rectangle" RadiusX="3" RadiusY="3" Fill="#52525B" Height="{TemplateBinding Height}" Width="{TemplateBinding Width}"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="true">
                                <Setter TargetName="rectangle" Property="Fill" Value="#71717A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Main Container Card with Outer DropShadow & Flat Square Border (CornerRadius="0") -->
    <Border Margin="10" CornerRadius="0" Background="#252526" BorderBrush="#3F3F46" BorderThickness="1" SnapsToDevicePixels="True">
        <Border.Effect>
            <DropShadowEffect BlurRadius="12" Color="#000000" Direction="270" Opacity="0.45" ShadowDepth="3"/>
        </Border.Effect>

        <Grid Margin="12" SnapsToDevicePixels="True">
            <Grid.RowDefinitions>
                <!-- Header -->
                <RowDefinition Height="Auto"/>
                <!-- Divider -->
                <RowDefinition Height="Auto"/>
                <!-- Device List -->
                <RowDefinition Height="*"/>
                <!-- Footer -->
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header Panel -->
            <Grid Grid.Row="0" Margin="2,0,2,8">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Bluetooth App Icon -->
                    <Path Data="M 10 2 L 10 24 L 17 17 L 12 12.5 L 17 8 L 10 2 M 10 12.5 L 4 6.5 M 10 12.5 L 4 18.5"
                          Fill="Transparent" 
                          Stroke="#60A5FA" 
                          StrokeThickness="1.2" 
                          Width="13" Height="17" 
                          Stretch="Uniform" 
                          Margin="0,0,8,0"
                          SnapsToDevicePixels="True"/>

                    <!-- Title -->
                    <TextBlock Text="Wireless Battery" 
                               Foreground="#F1F1F1" 
                               FontWeight="Bold" 
                               FontSize="13.5" 
                               VerticalAlignment="Center"/>

                    <!-- Subtitle Made by Ztk -->
                    <TextBlock Text="Made by Ztk" 
                               Foreground="#8E8E93" 
                               FontSize="9.5" 
                               FontWeight="Normal" 
                               VerticalAlignment="Bottom" 
                               Margin="6,0,0,2"/>
                </StackPanel>

                <!-- Refresh Button -->
                <Button Command="{Binding RefreshCommand}"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Background="Transparent"
                        BorderThickness="0"
                        Cursor="Hand"
                        ToolTip="Làm mới thiết bị">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="btnBorder" Background="Transparent" CornerRadius="4" Padding="5,4">
                                <Path x:Name="btnPath" Data="M 12 4 C 7.58 4 4 7.58 4 12 C 4 16.42 7.58 20 12 20 C 15.73 20 18.84 17.45 19.73 14 L 17.65 14 C 16.83 16.33 14.61 18 12 18 C 6 8.69 8.69 6 12 6 C 13.66 6 15.14 6.69 16.22 7.78 L 13 11 L 20 11 L 20 4 L 17.63 6.37 C 16.19 4.9 14.2 4 12 4 Z"
                                      Fill="#9CA3AF" Width="13" Height="13" Stretch="Uniform" SnapsToDevicePixels="True"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="btnBorder" Property="Background" Value="#37373D"/>
                                    <Setter TargetName="btnPath" Property="Fill" Value="#60A5FA"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>

            <!-- Divider -->
            <Rectangle Grid.Row="1" Height="1" Fill="#3F3F46" Margin="0,0,0,8" SnapsToDevicePixels="True"/>

            <!-- Device List / Empty State Container -->
            <Grid Grid.Row="2">
                <!-- Empty State Message -->
                <TextBlock Text="No device found"
                           Foreground="#8E8E93"
                           FontSize="12"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           FontStyle="Italic">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Devices.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <!-- Devices ItemsControl -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding Devices}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,6" 
                                        Background="#2D2D30" 
                                        BorderBrush="#3E3E42"
                                        BorderThickness="1"
                                        CornerRadius="4" 
                                        Padding="10,8"
                                        SnapsToDevicePixels="True">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <!-- Status Dot -->
                                            <ColumnDefinition Width="Auto"/>
                                            <!-- Device Info -->
                                            <ColumnDefinition Width="*"/>
                                            <!-- Source Tag -->
                                            <ColumnDefinition Width="Auto"/>
                                            <!-- Battery Icon -->
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Connection Status Dot Indicator -->
                                        <Ellipse Grid.Column="0" 
                                                 Width="8" Height="8" 
                                                 Fill="{Binding StatusBrush}" 
                                                 ToolTip="{Binding StatusTooltip}"
                                                 VerticalAlignment="Center" 
                                                 Margin="0,0,10,0"/>

                                        <!-- Device Name -->
                                        <TextBlock Grid.Column="1" 
                                                   Text="{Binding Name}" 
                                                   Foreground="#F1F1F1" 
                                                   FontSize="12" 
                                                   FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis" 
                                                   ToolTip="{Binding Name}"
                                                   VerticalAlignment="Center"/>

                                        <!-- Source Tag Badge (BLE / Classic) -->
                                        <Border Grid.Column="2" 
                                                Background="#1E1E1E" 
                                                CornerRadius="3" 
                                                Padding="5,2" 
                                                Margin="6,0,8,0"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="{Binding SourceText}" 
                                                       Foreground="#9CA3AF" 
                                                       FontSize="9" 
                                                       FontWeight="Bold"/>
                                        </Border>

                                        <!-- SVG Battery Icon Control with Tooltip -->
                                        <controls:BatteryIcon Grid.Column="3" 
                                                              VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>

            <!-- Footer Panel -->
            <Grid Grid.Row="3" Margin="0,8,0,0">
                <TextBlock Text="{Binding LastUpdatedText}" 
                           Foreground="#8E8E93" 
                           FontSize="9.5" 
                           HorizontalAlignment="Left" 
                           VerticalAlignment="Center"/>
            </Grid>
        </Grid>
    </Border>
</Window>
