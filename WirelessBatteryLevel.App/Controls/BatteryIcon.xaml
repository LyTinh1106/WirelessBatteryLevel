<UserControl x:Class="WirelessBatteryLevel.App.Controls.BatteryIcon"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WirelessBatteryLevel.App.Controls"
             mc:Ignorable="d" 
             SnapsToDevicePixels="True"
             UseLayoutRounding="True"
             Height="18" Width="38"
             d:DesignHeight="18" d:DesignWidth="38">

    <UserControl.Resources>
        <local:BatteryWidthConverter x:Key="WidthConverter"/>

        <!-- Battery Outer Outline Static Style -->
        <Style x:Key="BatteryOutlineHoverStyle" TargetType="Rectangle">
            <Setter Property="Stroke" Value="#D1D5DB"/>
        </Style>

        <!-- Battery Stud Terminal Static Style -->
        <Style x:Key="BatteryStudHoverStyle" TargetType="Rectangle">
            <Setter Property="Fill" Value="#D1D5DB"/>
        </Style>
    </UserControl.Resources>

    <Grid ToolTip="{Binding BatteryTooltip}" Background="Transparent" SnapsToDevicePixels="True">
        <!-- SVG Vector Windows 10 Native Battery Icon Container -->
        <Canvas Width="36" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center" SnapsToDevicePixels="True">
            <!-- Outer Battery Outline -->
            <Rectangle Canvas.Left="1" Canvas.Top="2" Width="32" Height="17"
                       Style="{StaticResource BatteryOutlineHoverStyle}"
                       StrokeThickness="1"
                       Fill="Transparent"
                       SnapsToDevicePixels="True" HorizontalAlignment="Center" VerticalAlignment="Top"/>

            <!-- Solid Battery Stud / Nipple Terminal on Right -->
            <Rectangle Canvas.Left="33" Canvas.Top="7" Width="2" Height="5"
                       Style="{StaticResource BatteryStudHoverStyle}"
                       SnapsToDevicePixels="True" HorizontalAlignment="Left" VerticalAlignment="Center"/>

            <!-- Inner Dynamic Fill Bar -->
            <Border Canvas.Left="3" Canvas.Top="3" Height="13" CornerRadius="0" ClipToBounds="True" SnapsToDevicePixels="True">
                <Grid Width="27">
                    <!-- Base Fill Bar -->
                    <Rectangle HorizontalAlignment="Left"
                               Height="12"
                               SnapsToDevicePixels="True">
                        <Rectangle.Style>
                            <Style TargetType="Rectangle">
                                <Setter Property="Fill" Value="{Binding BatteryFillBrush}"/>
                                <Setter Property="Width">
                                    <Setter.Value>
                                        <MultiBinding Converter="{StaticResource WidthConverter}" ConverterParameter="27">
                                            <Binding Path="BatteryLevelWidthRatio" />
                                        </MultiBinding>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Rectangle.Style>
                    </Rectangle>
                </Grid>
            </Border>
        </Canvas>
    </Grid>
</UserControl>
