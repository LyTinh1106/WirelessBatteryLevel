<UserControl x:Class="WirelessBatteryLevel.App.Controls.BatteryIcon"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WirelessBatteryLevel.App.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="24" d:DesignWidth="40">

    <UserControl.Resources>
        <local:BatteryWidthConverter x:Key="WidthConverter"/>
    </UserControl.Resources>

    <Grid ToolTip="{Binding BatteryTooltip}" Background="Transparent">
        <!-- SVG Vector Battery Icon Container -->
        <Canvas Width="32" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center">
            <!-- Outlined Battery Shell (Body + Nipple) -->
            <Path Data="M 2 3 C 0.895 3 0 3.895 0 5 L 0 13 C 0 14.105 0.895 15 2 15 L 24 15 C 25.105 15 26 14.105 26 13 L 26 11 C 27.105 11 28 10.105 28 9 L 28 9 C 28 7.895 27.105 7 26 7 L 26 5 C 26 3.895 25.105 3 24 3 Z M 2 5 L 24 5 C 24 5 24 13 24 13 L 2 13 Z"
                  Fill="#374151" 
                  Stroke="#9CA3AF" 
                  StrokeThickness="0.8"/>

            <!-- Inner Battery Fill Bar -->
            <Border Canvas.Left="3" Canvas.Top="5" Height="8" CornerRadius="1" ClipToBounds="True">
                <Grid Width="19">
                    <Rectangle HorizontalAlignment="Left"
                               Fill="{Binding BatteryFillBrush}"
                               Height="8">
                        <Rectangle.Style>
                            <Style TargetType="Rectangle">
                                <Setter Property="Width">
                                    <Setter.Value>
                                        <MultiBinding Converter="{StaticResource WidthConverter}" ConverterParameter="19">
                                            <Binding Path="BatteryLevelWidthRatio" />
                                        </MultiBinding>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Rectangle.Style>
                    </Rectangle>
                </Grid>
            </Border>
        </Canvas>
    </Grid>
</UserControl>
