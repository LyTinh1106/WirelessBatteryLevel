<UserControl x:Class="WirelessBatteryLevel.App.Controls.BatteryIcon"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WirelessBatteryLevel.App.Controls"
             mc:Ignorable="d" 
             SnapsToDevicePixels="True"
             UseLayoutRounding="True"
             Height="18" Width="38"
             d:DesignHeight="18" d:DesignWidth="38">

    <UserControl.Resources>
        <local:BatteryWidthConverter x:Key="WidthConverter"/>

        <!-- Battery Outer Outline Hover System Accent Style (Zero Position/Ratio Modification) -->
        <Style x:Key="BatteryOutlineHoverStyle" TargetType="Rectangle">
            <Setter Property="Stroke" Value="#D1D5DB"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                    <Setter Property="Stroke" Value="{DynamicResource SystemAccentBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Battery Stud Terminal Hover System Accent Style (Zero Position/Ratio Modification) -->
        <Style x:Key="BatteryStudHoverStyle" TargetType="Rectangle">
            <Setter Property="Fill" Value="#D1D5DB"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                    <Setter Property="Fill" Value="{DynamicResource SystemAccentBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid ToolTip="{Binding BatteryTooltip}" Background="Transparent" SnapsToDevicePixels="True">
        <!-- SVG Vector Windows 10 Native Battery Icon Container -->
        <Canvas Width="36" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center" SnapsToDevicePixels="True">
            <!-- Outer Battery Outline (Position & Ratios Untouched, Stroke Changes to System Accent on Hover) -->
            <Rectangle Canvas.Left="0.5" Canvas.Top="0.5" Width="32" Height="17"
                       Style="{StaticResource BatteryOutlineHoverStyle}"
                       StrokeThickness="1"
                       Fill="Transparent"
                       SnapsToDevicePixels="True"/>

            <!-- Solid Battery Stud / Nipple Terminal on Right (Position & Ratios Untouched, Fill Changes to System Accent on Hover) -->
            <Rectangle Canvas.Left="32" Canvas.Top="5" Width="3" Height="8"
                       Style="{StaticResource BatteryStudHoverStyle}"
                       SnapsToDevicePixels="True"/>

            <!-- Inner Dynamic Fill Bar (Adjusted to 27px for Perfectly Balanced Right Gap at 100%) -->
            <Border Canvas.Left="3" Canvas.Top="3" Height="12" CornerRadius="0" ClipToBounds="True" SnapsToDevicePixels="True">
                <Grid Width="27">
                    <Rectangle HorizontalAlignment="Left"
                               Fill="{Binding BatteryFillBrush}"
                               Height="12"
                               SnapsToDevicePixels="True">
                        <Rectangle.Style>
                            <Style TargetType="Rectangle">
                                <Setter Property="Width">
                                    <Setter.Value>
                                        <MultiBinding Converter="{StaticResource WidthConverter}" ConverterParameter="27">
                                            <Binding Path="BatteryLevelWidthRatio" />
                                        </MultiBinding>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Rectangle.Style>
                    </Rectangle>
                </Grid>
            </Border>
        </Canvas>
    </Grid>
</UserControl>
