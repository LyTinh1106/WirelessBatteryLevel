<Window x:Class="WirelessBatteryLevel.App.Controls.TrayHoverPopup"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:WirelessBatteryLevel.App.Controls"
        mc:Ignorable="d"
        Title="Wireless Battery Quick View" 
        SizeToContent="WidthAndHeight"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        Focusable="False"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        RenderOptions.BitmapScalingMode="HighQuality"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">

    <Border Margin="6" CornerRadius="0" Background="#252526" BorderBrush="#3F3F46" BorderThickness="1" SnapsToDevicePixels="True">
        <Border.Effect>
            <DropShadowEffect BlurRadius="8" Color="#000000" Direction="270" Opacity="0.35" ShadowDepth="2"/>
        </Border.Effect>

        <StackPanel Margin="10" MinWidth="220" MaxWidth="280">
            <!-- Header -->
            <Grid Margin="0,0,0,6">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Path Data="M 10 2 L 10 24 L 17 17 L 12 12.5 L 17 8 L 10 2 M 10 12.5 L 4 6.5 M 10 12.5 L 4 18.5"
                          Fill="Transparent" 
                          Stroke="#60A5FA" 
                          StrokeThickness="1.2" 
                          Width="11" Height="14" 
                          Stretch="Uniform" 
                          Margin="0,0,6,0"/>
                    <TextBlock Text="Wireless Devices" 
                               Foreground="#F1F1F1" 
                               FontWeight="Bold" 
                               FontSize="11.5"/>
                </StackPanel>
            </Grid>

            <Rectangle Height="1" Fill="#3F3F46" Margin="0,0,0,6"/>

            <!-- Devices Quick List -->
            <ItemsControl ItemsSource="{Binding Devices}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Ellipse Grid.Column="0" 
                                     Width="6" Height="6" 
                                     Fill="{Binding StatusBrush}" 
                                     VerticalAlignment="Center" 
                                     Margin="0,0,6,0"/>

                            <TextBlock Grid.Column="1" 
                                       Text="{Binding Name}" 
                                       Foreground="#E4E4E7" 
                                       FontSize="11" 
                                       TextTrimming="CharacterEllipsis" 
                                       VerticalAlignment="Center"/>

                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,0,0">
                                <TextBlock Text="{Binding BatteryTooltip}" 
                                           Foreground="#9CA3AF" 
                                           FontSize="10" 
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center" 
                                           Margin="0,0,4,0"/>
                                <controls:BatteryIcon VerticalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Text="No device found"
                       Foreground="#8E8E93"
                       FontSize="11"
                       HorizontalAlignment="Center"
                       FontStyle="Italic"
                       Margin="0,4">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Devices.Count}" Value="0">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </StackPanel>
    </Border>
</Window>
